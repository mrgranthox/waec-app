# WAEC platform — environment template.
# Copy to .env and fill. NEVER commit the real .env (plan §0.8: SOPS/age
# in production; this file exists for local dev convenience only).

# ── Data tier ──────────────────────────────────────────────────────────────
# Local compose Postgres (dev). Prod uses Neon serverless Postgres — see
# infra/compose/compose.prod.yaml and the Hetzner plan §6.
POSTGRES_PASSWORD=change-me-long-random
GRAFANA_PASSWORD=change-me-too

# DATABASE_URL is consumed by every Rust service that touches Postgres
# (auth, payment, handler, admin, data crate). In dev compose it points at
# the local container; in prod it points at Neon (or the Hetzner-managed
# instance). Format: postgres://user:pass@host:port/db?sslmode=require
DATABASE_URL=postgres://waec:change-me-long-random@postgres:5432/waec

# Neon serverless Postgres (prod). When set, services prefer this over the
# compose-internal Postgres. Obtain from the Neon console → Connection Details.
# NEON_DATABASE_URL=postgres://user:pass@ep-xxxxx-pooler.eu-central-1.aws.neon.tech/waec?sslmode=require

# ── Paystack Ghana ─────────────────────────────────────────────────────────
# Secret key + webhook HMAC SHA-512 key from the Paystack dashboard.
PAYSTACK_SECRET=sk_test_xxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ── Residential proxy pool ─────────────────────────────────────────────────
# West African residential IP rotator (plan task 1.7).
PROXY_POOL_URL=http://proxy-rotator:8081

# ── JWT signing keys ───────────────────────────────────────────────────────
# PEM file paths. Prod: SOPS-encrypted files mounted by compose.
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem

# ── Redis ──────────────────────────────────────────────────────────────────
# Grace-token TTL keys + session cache (plan §2.7).
REDIS_URL=redis://redis:6379

# ── Kafka ──────────────────────────────────────────────────────────────────
# Event pipeline (plan §2.6). Dev: compose-internal single broker.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
